{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "쌀먹",
  "version": "0.1.0",
  "identifier": "com.godju.ssalmeok",
  "build": {
    "beforeDevCommand": "pnpm sidecar:ensure && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm sidecar:ensure && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/codexbar"],
    "resources": ["resources/*"],
    "copyright": "Copyright © 2026 godju",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
